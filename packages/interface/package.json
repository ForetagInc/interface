{
	"name": "@foretag/interface",
	"private": false,
	"version": "1.0.0-alpha.5",
	"description": "Interface UI components, design tokens, primitives and shared interface foundations by Foretag",
	"license": "Unlicense",
	"author": "Chiru <chiru@foretag.co> (https://foretag.co)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ForetagInc/interface.git",
		"directory": "packages/interface"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./src/styles/app.css",
		"./themes": {
			"types": "./dist/lib/theme.d.ts",
			"import": "./dist/lib/theme.js"
		}
	},
	"files": [
		"src",
		"dist",
		"UNLICENSE"
	],
	"scripts": {
		"build": "rm -rf dist && bunx tsc -p tsconfig.build.json",
		"typecheck": "bunx tsc --noEmit",
		"test": "bunx vitest run --config vitest.config.ts"
	},
	"peerDependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@tabler/icons-webfont": "^3.46.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"react-day-picker": "^10.0.2",
		"react-hook-form": "^7.85.0",
		"react-resizable-panels": "^4.12.2",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^6.10.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.7",
		"jsdom": "^25.0.1"
	}
}
